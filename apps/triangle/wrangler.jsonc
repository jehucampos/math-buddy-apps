{
  // "name" MUST equal the existing Worker's name in the Cloudflare dashboard,
  // otherwise a deploy creates a new Worker. The build refuses to deploy while it is "solitary-tree-bbee".
  "name": "solitary-tree-bbee",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist"
  }
}
