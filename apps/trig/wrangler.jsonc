{
  // "name" MUST equal the existing Worker's name in the Cloudflare dashboard,
  // otherwise a deploy creates a new Worker. The build refuses to deploy while it is "floral-heart-d578".
  "name": "floral-heart-d578",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist"
  }
}
